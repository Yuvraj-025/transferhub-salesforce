<?xml version='1.0' encoding='UTF-8'?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
  <fullName>TH_Player_Consistency</fullName>
  <active>true</active>
  <errorConditionFormula>AND(Fictional_Demo_Record__c, OR(Birthdate&gt;TODAY(),Market_Value__c&lt;0,Valuation_Date__c&gt;TODAY(),AND(ISPICKVAL(Player_Status__c,"Free Agent"),OR(NOT(ISBLANK(AccountId)),NOT(ISBLANK(Contract_Expiry__c)))),AND(NOT(ISPICKVAL(Player_Status__c,"Free Agent")),OR(ISBLANK(AccountId),ISBLANK(Contract_Expiry__c))),AND(NOT(ISBLANK(Height_cm__c)),Height_cm__c&lt;=0),AND(NOT(ISBLANK(Jersey_Number__c)),OR(Jersey_Number__c&lt;1,Jersey_Number__c&gt;99))))</errorConditionFormula>
  <errorMessage>Check dates, nonnegative market value, height, jersey number and free-agent/club/contract consistency.</errorMessage>
</ValidationRule>