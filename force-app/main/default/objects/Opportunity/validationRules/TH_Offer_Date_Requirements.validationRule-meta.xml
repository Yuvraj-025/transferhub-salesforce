<?xml version='1.0' encoding='UTF-8'?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
  <fullName>TH_Offer_Date_Requirements</fullName>
  <active>true</active>
  <errorConditionFormula>AND(Fictional_Demo_Record__c, OR(AND(OR(ISPICKVAL(Negotiation_Stage__c,"Offer Submitted"),ISPICKVAL(Negotiation_Stage__c,"Medical"),ISPICKVAL(Negotiation_Stage__c,"Contract"),ISPICKVAL(Negotiation_Stage__c,"Completed")),ISBLANK(Offer_Date__c)),Offer_Date__c&gt;TODAY(),AND(NOT(ISBLANK(Offer_Date__c)),NOT(ISBLANK(Completion_Date__c)),Offer_Date__c&gt;Completion_Date__c),AND(NOT(ISBLANK(Contract_Duration_Months__c)),Contract_Duration_Months__c&lt;=0)))</errorConditionFormula>
  <errorMessage>Check offer date and positive contract duration; an offer date is required from Offer Submitted onward.</errorMessage>
</ValidationRule>