<?xml version='1.0' encoding='UTF-8'?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
  <fullName>TH_Nonnegative_Fees</fullName>
  <active>true</active>
  <errorConditionFormula>AND(Fictional_Demo_Record__c, OR(Proposed_Transfer_Fee__c&lt;0,Final_Transfer_Fee__c&lt;0,Agent_Fee__c&lt;0))</errorConditionFormula>
  <errorMessage>Fees cannot be negative.</errorMessage>
</ValidationRule>