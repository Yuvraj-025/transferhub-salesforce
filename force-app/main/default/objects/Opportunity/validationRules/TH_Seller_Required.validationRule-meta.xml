<?xml version='1.0' encoding='UTF-8'?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
  <fullName>TH_Seller_Required</fullName>
  <active>true</active>
  <errorConditionFormula>AND(Fictional_Demo_Record__c, OR(AND(NOT(Free_Agent_Signing__c),ISBLANK(Selling_Club__c)),AND(Free_Agent_Signing__c,OR(NOT(ISBLANK(Selling_Club__c)),ISPICKVAL(Deal_Type__c,"Loan"),Proposed_Transfer_Fee__c&lt;&gt;0,AND(NOT(ISBLANK(Final_Transfer_Fee__c)),Final_Transfer_Fee__c&lt;&gt;0)))))</errorConditionFormula>
  <errorMessage>Ordinary deals require a seller. Free-agent signings must be permanent, have no seller and have zero transfer fees.</errorMessage>
</ValidationRule>