<?xml version='1.0' encoding='UTF-8'?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
  <fullName>TH_Completion_Requirements</fullName>
  <active>true</active>
  <errorConditionFormula>AND(Fictional_Demo_Record__c, OR(AND(ISPICKVAL(Deal_Status__c,"Completed"),OR(ISBLANK(Final_Transfer_Fee__c),ISBLANK(Completion_Date__c),ISBLANK(Contract_Duration_Months__c),Contract_Duration_Months__c&lt;=0,Completion_Date__c&gt;TODAY(),AND(ISPICKVAL(Deal_Type__c,"Loan"),OR(ISBLANK(Selling_Club__c),ISBLANK(Loan_End_Date__c),Loan_End_Date__c&lt;=Completion_Date__c)))),AND(NOT(ISPICKVAL(Deal_Status__c,"Completed")),OR(NOT(ISBLANK(Completion_Date__c)),NOT(ISBLANK(Final_Transfer_Fee__c))))))</errorConditionFormula>
  <errorMessage>Completed deals require final fee, completion date and positive duration; loans require seller and end date. Uncompleted deals must not contain completion date or final fee.</errorMessage>
</ValidationRule>