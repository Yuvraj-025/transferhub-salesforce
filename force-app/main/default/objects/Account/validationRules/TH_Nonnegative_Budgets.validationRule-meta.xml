<?xml version='1.0' encoding='UTF-8'?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
  <fullName>TH_Nonnegative_Budgets</fullName>
  <active>true</active>
  <errorConditionFormula>AND(Fictional_Demo_Record__c, OR(Estimated_Transfer_Budget__c &lt; 0, Current_Transfer_Spending__c &lt; 0))</errorConditionFormula>
  <errorMessage>Budget and spending cannot be negative.</errorMessage>
</ValidationRule>